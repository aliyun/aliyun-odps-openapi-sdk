// 限流：每用户每秒最多 10 次请求
async function setTaxonomyPolicy(namespace: string, taxonomyId: string, policy: SetPolicyRequest): Policy {
  var runtime = new Util.RuntimeOptions{};
  var path = `${getTaxonomyPath(namespace, taxonomyId)}:setPolicy`;
  var query: map[string]string = {};
  query["method"] = "setPolicy";
  return requestWithModel(policy, 'POST', path, query, runtime);
