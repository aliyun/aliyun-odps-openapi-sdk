/**
 * ==================================== Models ====================================
 */
// Model 实体定义
model Model {
  name?: string(name='name', description='模型的完整路径。e.g., projects/{projectId}/schemas/{schemaName}/models/{modelName}'),
  modelName?: string(name='modelName', description='模型名。上级 Schema 内唯一。大小写不敏感。包含字符：[a-z][A-Z][0-9]_，字节个数范围 [3, 255]'),
  versionName?: string(name='versionName', description='版本名。同一 model 范围内唯一。大小写不敏感。包含字符：[a-z][A-Z][0-9]_，字节个数范围 [3, 255]'),
  defaultVersion?: string(name='defaultVersion', description='模型的默认版本名'),
  createTime?: string(name='createTime', description='模型的创建时间（毫秒）'),
  updateTime?: string(name='updateTime', description='模型的修改时间（毫秒）'),
  versionCreateTime?: string(name='versionCreateTime', description='版本的创建时间（毫秒）'),
  versionUpdateTime?: string(name='versionUpdateTime', description='版本的修改时间（毫秒）'),
  description?: string(name='description', description='模型的描述，最长 1KB'),
  versionDescription?: string(name='versionDescription', description='版本的描述，最长 1KB'),
  expirationDays?: integer(name='expirationDays', description='模型基于最近更新时间的生命周期（天）'),
  versionExpirationDays?: integer(name='versionExpirationDays', description='版本基于最近更新时间的生命周期（天）'),
  sourceType?: string(name='sourceType', description='模型的来源类型，创建后不支持修改'),
  modelType?: string(name='modelType', description='模型的类型，创建后不支持修改'),
  labels?: map[string]string(name='labels', description='模型的标签'),
  transform?: map[string]string(name='transform', description='版本的预处理信息'),
  path?: string(name='path', description='版本对应模型文件的路径'),
  options?: map[string]string(name='options', description='版本的参数'),
  extraInfo?: map[string]string(name='extraInfo', description='模型的额外信息'),
  versionExtraInfo?: map[string]string(name='versionExtraInfo', description='版本的额外信息'),
  trainingInfo?: map[string]string(name='trainingInfo', description='版本的训练信息'),
  inferenceParameters?: map[string]string(name='inferenceParameters', description='版本的推理参数'),
  featureColumns?: ModelFieldSchema(name='featureColumns', description='版本的列 schema 定义'),
  tasks?: [string](name='tasks', description='version 支持的所有 task 类型。要求：对于 LLM/MLLM 类型模型，可取值 text-generation，chat，sentence-embedding 中的一个或多个. 对于 BOOSTED_TREE_CLASSIFIER 类型模型，只能取值为 [predict, predict-proba, feature-importance]（顺序任意）. 对于 BOOSTED_TREE_REGRESSOR 类型模型，只能取值为 [predict, feature-importance]（顺序任意）'),
}

// ModelFieldSchema 定义
model ModelFieldSchema {
  fieldName?: string(name='fieldName', description='列名或 struct 字段名'),
  sqlTypeDefinition?: string(name='sqlTypeDefinition', description='SQL DDL 中的列类型定义'),
  typeCategory?: string(name='typeCategory', description='字段类型'),
  mode?: string(name='mode', description='字段模式：REQUIRED 或 NULLABLE'),
  fields?: [ModelFieldSchema](name='fields', description='STRUCT 类型的子字段'),
  description?: string(name='description', description='列的 comment'),
  maxLength?: string(name='maxLength', description='CHAR/VARCHAR 类型的最大长度'),
  precision?: string(name='precision', description='DECIMAL 类型的精度'),
  scale?: string(name='scale', description='DECIMAL 类型的 scale'),
  defaultValueExpression?: string(name='defaultValueExpression', description='默认值的表达式字符串'),
  dimension?: string(name='dimension', description='如果是 VECTOR 类型，表示向量的维度')
}

model ListModelsResponse = {
  models?: [Model],
  nextPageToken?: string
}

model ListModelVersionsResponse = {
  models?: [Model],
  nextPageToken?: string
}

// 路径生成函数
function getModelPath(projectId: string, schemaName: string, modelName: string, versionName: string): string {
  if (Util.isUnset(versionName)) {
    return `/api/catalog/v1alpha/projects/${projectId}/schemas/${schemaName}/models/${modelName}`;
  } else {
    return `/api/catalog/v1alpha/projects/${projectId}/schemas/${schemaName}/models/${modelName}@${versionName}`;
  }
}

// 创建模型
// 限流：每用户每秒最多 10 次请求
async function createModel(projectId: string, schemaName: string, model: Model): Model {
  var runtime = new Util.RuntimeOptions{};
  var path = `/api/catalog/v1alpha/projects/${projectId}/schemas/${schemaName}/models`;
  return requestWithModel(model, 'POST', path, null, runtime);
}

// 列出模型
// 限流：每用户每秒最多 10 次请求
async function listModels(projectId: string, schemaName: string, pageSize: integer, pageToken: string): ListModelsResponse {
  var runtime = new Util.RuntimeOptions{};
  var path = `/api/catalog/v1alpha/projects/${projectId}/schemas/${schemaName}/models`;
  var query: map[string]string = {};
  
  if (!Util.isUnset(pageSize)) {
    query["pageSize"] = McUtil.toString(pageSize);
  }
  if (!Util.isUnset(pageToken)) {
    query["pageToken"] = pageToken;
  }
  
  return requestWithModel(new ListModelsResponse{}, 'GET', path, query, runtime);
}

// 获取模型
// 限流：每用户每秒最多 100 次请求
async function getModel(projectId: string, schemaName: string, modelName: string, versionName: string): Model {
  var runtime = new Util.RuntimeOptions{};
  var path = getModelPath(projectId, schemaName, modelName, versionName);
  return requestWithModel(new Model{}, 'GET', path, null, runtime);
}

// 更新模型
// 限流：每用户每秒最多 10 次请求
async function updateModel(projectId: string, schemaName: string, modelName: string, 
                          model: Model, updateMask: string, versionName: string): Model {
  var runtime = new Util.RuntimeOptions{};
  var path = getModelPath(projectId, schemaName, modelName, versionName);
  var query: map[string]string = {};
  
  if (!Util.isUnset(updateMask)) {
    query["updateMask"] = updateMask;
  }
  
  return requestWithModel(model, 'PATCH', path, query, runtime);
}

// 删除模型
// 限流：每用户每秒最多 10 次请求
async function deleteModel(projectId: string, schemaName: string, modelName: string): HttpResponse {
  var runtime = new Util.RuntimeOptions{};
  var path = getModelPath(projectId, schemaName, modelName, null);
  return requestWithoutModel(null, 'DELETE', path, null, runtime);
}

// 创建模型版本
// 限流：每用户每秒最多 10 次请求
async function createModelVersion(projectId: string, schemaName: string, modelName: string, model: Model): Model {
  var runtime = new Util.RuntimeOptions{};
  var path = `/api/catalog/v1alpha/projects/${projectId}/schemas/${schemaName}/models/${modelName}:createVersion`;
  return requestWithModel(model, 'POST', path, null, runtime);
}

// 删除模型版本
// 限流：每用户每秒最多 10 次请求
async function deleteModelVersion(projectId: string, schemaName: string, modelName: string, versionName: string): HttpResponse {
  var runtime = new Util.RuntimeOptions{};
  var path = `/api/catalog/v1alpha/projects/${projectId}/schemas/${schemaName}/models/${modelName}@${versionName}:deleteVersion`;
  return requestWithoutModel(null, 'DELETE', path, null, runtime);
}



// 列出模型版本
// 限流：每用户每秒最多 10 次请求
async function listModelVersions(projectId: string, schemaName: string, modelName: string, 
                                pageSize: integer, pageToken: string): ListModelVersionsResponse {
  var runtime = new Util.RuntimeOptions{};
  var path = `/api/catalog/v1alpha/projects/${projectId}/schemas/${schemaName}/models/${modelName}:listVersions`;
  var query: map[string]string = {};
  
  if (!Util.isUnset(pageSize)) {
    query["pageSize"] = McUtil.toString(pageSize);
  }
  if (!Util.isUnset(pageToken)) {
    query["pageToken"] = pageToken;
  }
  
  return requestWithModel(new ListModelVersionsResponse{}, 'GET', path, query, runtime);
}

// 获取模型策略
// 限流：每用户每秒最多 100 次请求
async function getModelPolicy(projectId: string, schemaName: string, modelName: string): Policy {
  var runtime = new Util.RuntimeOptions{};
  var path = `${getModelPath(projectId, schemaName, modelName, null)}:getPolicy`;
  var query: map[string]string = {};
  return requestWithModel(new Policy{}, 'POST', path, query, runtime);
}

// 设置模型策略
// 限流：每用户每秒最多 10 次请求
async function setModelPolicy(projectId: string, schemaName: string, modelName: string, policy: SetPolicyRequest): Policy {
  var runtime = new Util.RuntimeOptions{};
  var path = `${getModelPath(projectId, schemaName, modelName, null)}:setPolicy`;
  var query: map[string]string = {};
  return requestWithModel(policy, 'POST', path, query, runtime);
}

/**
 * ==================================== Search ====================================
 */
// SearchResultEntry 实体定义
model SearchResultEntry {
  name?: string(name='name', description='实体的完整路径。e.g., projects/{projectId}/schemas/{schemaName}/tables/{tableName}'),
  displayName?: string(name='displayName', description='实体的名称'),
  type?: string(name='type', description='实体的类型，例如 TABLE、RESOURCE、SCHEMA 等'),
  aspects?: map[string]string(name='aspects', description='实体的其他信息'),
  createTime?: string(name='createTime', description='实体的创建时间（毫秒）'),
  lastModifiedTime?: string(name='lastModifiedTime', description='实体的修改时间（毫秒）'),
  description?: string(name='description', description='实体的描述'),
}

model SearchResponse = {
  entries?: [SearchResultEntry],
  nextPageToken?: string
}

/**
 * 搜索指定 namespace 下的各种实体。
 *
 * @param namespaceId 主账号ID，在该主账号范围内执行搜索。
 *
 * @param query 搜索查询串，由 1 个到多个查询条件组成，查询条件之间用逗号 `,` 分隔。
 *  - 语法示例：`name:foo,type=TABLE,region=cn-hangzhou`、`description:bar,type=RESOURCE,project=proj`
 *  - 查询条件列表：
 *    1. `name:foo`：将 `foo` 作为子字符串与实体名称匹配。
 *    2. `description:bar`：将 `bar` 作为子字符串与实体描述匹配。
 *    3. `type=TABLE`：匹配特定类型的实体（必选）。当前支持 `TABLE`、`RESOURCE`、`SCHEMA`。
 *    4. `project=proj`：仅搜索指定单个 project 下的查询条件。要求调用方拥有该 project 的 `SearchProject` 权限。
 *    5. `project=(proj1|proj2|proj3)`：搜索多个 project 下的实体（最多 512 个）。要求调用方同时拥有这些 projects 的 `SearchProject` 权限。
 *    6. `region=region_id`：搜索指定 region 的 project 下的实体。
 *  - 约束：
 *    - 查询条件 3 必选。
 *    - 查询条件 4 与查询条件 5 不能同时存在。
 *    - 查询条件 6 不能与查询条件 4 或 5 同时存在。
 *
 * @param pageSize 每页返回结果条数。
 *  - 必须 > 0
 *  - 最大 100
 *
 * @param pageToken 翻页 token；用于从上一次响应的 token 继续获取下一页。
 *
 * @param orderBy 结果排序方式。可取值包括：
 *  - `default`：内部存储顺序（默认）
 *  - `create_time asc`：创建时间正序
 *  - `create_time desc`：创建时间倒序
 *  - `last_modified_time asc`：最近修改时间正序
 *  - `last_modified_time desc`：最近修改时间倒序
 */
// 限流：每用户每秒最多 10 次请求
async function search(namespaceId: string, query: string, pageSize: integer, pageToken: string, orderBy: string): SearchResponse {
  var runtime = new Util.RuntimeOptions{};
  var path = `/api/catalog/v1alpha/namespaces/${namespaceId}:search`;
  var params: map[string]string = {};

  if (!Util.isUnset(pageSize)) {
    params["pageSize"] = McUtil.toString(pageSize);
  }
  if (!Util.isUnset(pageToken)) {
    params["pageToken"] = pageToken;
  }
  if (!Util.isUnset(query)) {
    params["query"] = McUtil.toString(query);
  }
  if (!Util.isUnset(orderBy)) {
    params["orderBy"] = McUtil.toString(orderBy);
  }

  return requestWithModel(new SearchResponse{}, 'POST', path, params, runtime);
}

model DataToken = {
  version?: string(name='version', description='格式版本，目前为 V1'),
  type?: string(name='type', description='类型，目前只支持 STS'),
  value?: string(name='value', description='Token 的内容，base64 编码'),
  expiration?: string(name='expiration', description='过期时间')
}

// 限流：每用户每秒最多 100 次请求
async function getDataToken(table: Table, duration: integer): DataToken {
  var runtime = new Util.RuntimeOptions{};
  var path = getTablePath(table);
  var fullPath = `${path}:getDataToken`;
  var params: map[string]string = {};
  if (!Util.isUnset(duration)) {
    params["duration"] = McUtil.toString(duration);
  }
  return requestWithModel(new Policy{}, 'POST', fullPath, params, runtime);
}
